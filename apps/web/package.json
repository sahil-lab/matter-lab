{
  "name": "@matterlab/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MATTER LAB interactive 3D workspace (React + Three.js).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "build:e2e": "vite build --mode e2e --outDir dist-e2e",
    "preview:e2e": "vite preview --outDir dist-e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:e2e": "playwright test",
    "test:e2e:build": "playwright test -c playwright.preview.config.ts",
    "screenshots": "playwright test -c playwright.shots.config.ts",
    "benchmark": "playwright test -c playwright.bench.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@matterlab/contracts": "*",
    "@matterlab/core": "*",
    "@matterlab/forcefield": "*",
    "@matterlab/lab-runtime": "*",
    "@matterlab/lab-science": "*",
    "@matterlab/quantum": "*",
    "@matterlab/reactions": "*",
    "@rdkit/rdkit": "^2026.9.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "d3-array": "^3.2.5",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "lucide-react": "^1.72.0",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "~0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "~0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "vite": "^8.3.8"
  }
}
