{
  "name": "@matterlab/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MATTER LAB Astra lab backend: scene/run persistence, catalogs, templates and exports (Agent 09). Builds on the existing services/science PostgreSQL database; adds lab_* tables incrementally.",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx src/seed/cli.ts"
  },
  "dependencies": {
    "@matterlab/contracts-lab": "*",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "tsx": "^4.23.15",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2"
  }
}
