{
  "name": "matter-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MATTER LAB - an interactive, GPU-accelerated 3D laboratory for building and investigating atoms, molecules and reactions.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace @matterlab/web",
    "build": "npm run build --workspace @matterlab/web",
    "preview": "npm run preview --workspace @matterlab/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p qa/tsconfig.json",
    "lint": "node qa/check-repository.mjs",
    "test": "node qa/run-tests.mjs all",
    "test:unit": "node qa/run-tests.mjs unit",
    "test:performance": "node qa/run-tests.mjs performance",
    "test:partition": "node qa/check-test-partition.mjs",
    "test:qa": "node --test qa/harness.test.mjs",
    "test:watch": "vitest --exclude **/performance.test.ts",
    "test:e2e": "npm run test:e2e --workspace @matterlab/web",
    "test:e2e:build": "npm run test:e2e:build --workspace @matterlab/web",
    "test:smoke": "playwright test --config qa/playwright.smoke.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test:qa && npm run test:partition && npm run test:unit && npm run build && npm run verify:build",
    "verify:build": "node qa/check-build.mjs",
    "release:web": "npm run build && npm run verify:build && node tools/release/web-manifest.mjs",
    "desktop:check": "node tools/release/desktop.mjs check",
    "desktop:lock": "node tools/release/desktop.mjs lock",
    "desktop:dev": "node tools/release/desktop.mjs dev",
    "desktop:build": "node tools/release/desktop.mjs build",
    "desktop:bundle": "node tools/release/desktop.mjs bundle",
    "screenshots": "npm run screenshots --workspace @matterlab/web",
    "benchmark": "npm run benchmark --workspace @matterlab/web",
    "data:elements": "node tools/data/build-elements.mjs",
    "data:isotopes": "node tools/data/build-isotopes.mjs",
    "data:species": "node tools/data/build-species.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
