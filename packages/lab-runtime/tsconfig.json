{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "paths": {
      "@matterlab/lab-runtime": ["./src/index.ts"],
      "@matterlab/contracts": ["../contracts/src/index.ts"],
      "@matterlab/lab-science": ["../lab-science/src/index.ts"]
